spring.application.name=movierecommendation

# PostgreSQL local development
spring.datasource.url=jdbc:postgresql://localhost:5432/movierecommendation
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=true
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.physical_naming_strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.properties.hibernate.implicit_naming_strategy=org.hibernate.boot.model.naming.ImplicitNamingStrategyLegacyJpaImpl
spring.jpa.properties.hibernate.default_batch_fetch_size=100


spring.thymeleaf.cache=false
spring.thymeleaf.encoding=UTF-8
server.port=8080

spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=30000

# Optional integrations
tmdb.api.key=${TMDB_API_KEY:}
openai.api.key=${OPENAI_API_KEY:}
ai.base-url=${AI_BASE_URL:https://api.openai.com/v1}
ai.api-key=${AI_API_KEY:${OPENAI_API_KEY:}}
ai.chat-model=${AI_CHAT_MODEL:gpt-4o-mini}
ai.timeout-seconds=${AI_TIMEOUT_SECONDS:8}

# Use a random value with at least 32 characters outside source control.
app.remember-me-key=${REMEMBER_ME_KEY:CHANGE_ME_WITH_A_RANDOM_32_CHARACTER_SECRET}

app.verification.code-expiration-minutes=10
app.verification.code-length=6

# Demo accounts/test data are opt-in and must stay disabled in production.
app.demo.seed-enabled=${DEMO_SEED_ENABLED:false}
app.demo.password=${DEMO_PASSWORD:}

recommendation.alpha=0.40
recommendation.beta=0.40
recommendation.gamma=0.20

logging.level.com.example.movierecommendation=INFO
